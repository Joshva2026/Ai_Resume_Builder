# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (TiDB / Aiven / PlanetScale MySQL connection string details)
DB_HOST=your_cloud_mysql_host
DB_PORT=3306
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=resumeforge

# JWT Configuration
JWT_SECRET=generate_a_strong_random_secret_string
JWT_REFRESH_SECRET=generate_another_strong_random_secret_string
JWT_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# Frontend Configuration
FRONTEND_URL=https://your-frontend-domain.vercel.app

# File Upload Configuration
MAX_FILE_SIZE=50mb

# Email Configuration (for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# API Keys for Third-party Services
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_CLOUD_API_KEY=your_google_cloud_api_key_here

# Security
CORS_ORIGIN=https://your-frontend-domain.vercel.app
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Database Logging
DB_LOGGING=false
