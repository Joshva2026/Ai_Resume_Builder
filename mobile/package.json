{
  "name": "ai-resume-forge-mobile",
  "version": "1.0.0",
  "description": "Mobile application wrapper for AI Resume Builder",
  "main": "index.js",
  "scripts": {
    "init-mobile": "npm install @capacitor/core @capacitor/cli @capacitor/ios @capacitor/android",
    "cap-init": "npx cap init \"AI Resume Forge\" \"dev.resumeforge.app\" --web-dir=../Fontend",
    "add-ios": "npx cap add ios",
    "add-android": "npx cap add android",
    "sync": "npx cap sync",
    "open-ios": "npx cap open ios",
    "open-android": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/core": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/ios": "^6.0.0"
  }
}
